{
  "name": "@scholar/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run -c vitest.eval.config.ts",
    "eval:record": "node eval/run.mjs record",
    "eval:live": "node eval/run.mjs live",
    "secrets:push": "node scripts/push-secrets.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply scholar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply scholar-db --remote"
  },
  "dependencies": {
    "@scholar/shared": "*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
