{
  "name": "@scholar/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run -c vitest.eval.config.ts",
    "eval:record": "node eval/run.mjs record",
    "integration": "node scripts/integration.mjs",
    "eval:live": "node eval/run.mjs live",
    "secrets:push": "node scripts/push-secrets.mjs",
    "cf-typegen": "wrangler types --env-file=typegen.env --include-runtime=false --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply scholar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply scholar-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply scholar-db-staging --remote --env staging",
    "deploy:staging": "npm run db:migrate:staging && wrangler deploy --env staging"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.3.1",
    "@scholar/shared": "*",
    "hono": "^4.13.16",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@scholar/test-support": "*",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
