{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scholar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "6de82fc604465aa52a67dee951309199",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scholar-db",
      "database_id": "4da3d12e-056a-4335-8359-034a9a8d628f",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "scholar-jobs", "binding": "JOBS" }]
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "scholar-files" }],
  // Public lookups (search results, DOI and retraction checks, reference lookups) are cached here, not in the database: docs/spikes/R6-kv-cache.md.
  // Only public data is ever put in this namespace.
  "kv_namespaces": [{ "binding": "CACHE", "id": "2e43e4d46b59423cafeecd08c383dba0" }],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "S2_THROTTLE", "class_name": "S2Throttle" }, { "name": "API_GATE", "class_name": "ApiGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S2Throttle"] }, { "tag": "v2", "new_sqlite_classes": ["ApiGate"] }],
  // Per-IP limits (the binding's period can only be 10 or 60 seconds). Search is the expensive route: it fans out to 4 APIs.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "VERIFY_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ASK_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } }
  ],
  // Daily housekeeping (expired cache/sessions/oauth states, old usage rows): see src/maintenance.ts
  "triggers": { "crons": ["17 3 * * *"] },
  // Tells /api/v1/health/jobs that the daily job is expected here (staging has no schedule, so it does not set this).
  "vars": { "EXPECT_CRON": "1" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },

  // A second, empty copy of the service to try a change on before production: `npm run deploy:staging -w apps/api`.
  // Its own database, file bucket, queue and rate-limit counters, so nothing here can touch real people's data. No daily clean-up
  // job. Secrets are separate too (`wrangler secret put NAME --env staging`); sign-in works only after this address is added
  // to the Google/ORCID redirect list (docs/runbook.md, "Staging").
  "env": {
    "staging": {
      "name": "scholar-staging",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scholar-db-staging",
          "database_id": "59573daa-9ce0-4ccf-a5d0-5ab8fa23e679",
          "migrations_dir": "migrations"
        }
      ],
      "queues": { "producers": [{ "queue": "scholar-jobs-staging", "binding": "JOBS" }] },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "scholar-files-staging" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "4fba839cd6a84242955f48463b5bef02" }],
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "S2_THROTTLE", "class_name": "S2Throttle" }, { "name": "API_GATE", "class_name": "ApiGate" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S2Throttle"] }, { "tag": "v2", "new_sqlite_classes": ["ApiGate"] }],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "VERIFY_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
        { "name": "ASK_LIMITER", "namespace_id": "2004", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 240, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": { "crons": [] },
      // EXPECT_CRON is "0": staging has no schedule, so /api/v1/health/jobs must not report a job that was never meant to run.
      "vars": { "SENTRY_ENVIRONMENT": "staging", "EXPECT_CRON": "0" },
      "observability": { "enabled": true }
    }
  }
}
