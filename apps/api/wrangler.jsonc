{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scholar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "6de82fc604465aa52a67dee951309199",
  // The own domain (sodhsetu.in, bought at Spaceship, its DNS on Cloudflare). A custom domain needs the zone to be Active in this account and no other DNS record on the name; Cloudflare
  // then makes the record and the certificate. `www` is a redirect rule to this name, not a second Worker domain. workers.dev stays on while people move over.
  "routes": [{ "pattern": "sodhsetu.in", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/oauth-authorization-server", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scholar-db",
      "database_id": "4da3d12e-056a-4335-8359-034a9a8d628f",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "scholar-jobs", "binding": "JOBS" }]
  },
  // The reading of an open-access paper into the shared index (src/oa/workflow.ts, docs/spikes/R9-workflows.md): one instance per try, named steps, retries, checkpoints.
  "workflows": [
    { "name": "scholar-oa-ingest", "binding": "OA_INGEST", "class_name": "OaIngest" },
    // The literature scan (src/litscan/workflow.ts, docs/design/litscan.md): one instance per scan, one step per sub-question.
    { "name": "scholar-litscan", "binding": "LITSCAN", "class_name": "LitscanRun" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "scholar-files" }],
  // Public lookups (search results, DOI and retraction checks, reference lookups) are cached here, not in the database: docs/spikes/R6-kv-cache.md.
  // Only public data is ever put in this namespace.
  // The MCP server (src/mcp) keeps its OAuth clients, grants and tokens in a namespace of its own, bound as OAUTH_KV (the name is fixed by @cloudflare/workers-oauth-provider): not in CACHE,
  // which holds only public data. Without that binding the server stays off whatever MCP says. Created on 9 Nov 2026 (`npx wrangler kv namespace create OAUTH_KV`, and the same with
  // `--env staging` for staging below). The binding alone turns nothing on: the server stays off until "MCP" is set in vars (docs/runbook.md, "MCP server").
  "kv_namespaces": [
    { "binding": "CACHE", "id": "2e43e4d46b59423cafeecd08c383dba0" },
    { "binding": "OAUTH_KV", "id": "183f82ac6f9245a58e8d05f0d98f5865" }
  ],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "S2_THROTTLE", "class_name": "S2Throttle" }, { "name": "API_GATE", "class_name": "ApiGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S2Throttle"] }, { "tag": "v2", "new_sqlite_classes": ["ApiGate"] }],
  // Per-IP limits (the binding's period can only be 10 or 60 seconds). Search is the expensive route: it fans out to 4 APIs.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "VERIFY_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ASK_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } }
  ],
  // Daily housekeeping (expired cache/sessions/oauth states, old usage rows): see src/maintenance.ts
  "triggers": { "crons": ["17 3 * * *"] },
  // Tells /api/v1/health/jobs that the daily job is expected here (staging has no schedule, so it does not set this).
  // A switch that must survive a deploy goes here too (same for CHAT_JUDGE and CHAT_CONTEXT). "TRENDING" ("The Trending list" in docs/runbook.md):
  //   "dark" = the job makes the list and the route hides it (nobody is shown a list the owner has not read);
  //   "off"  = the route hides it and the job is stopped too: THE LAUNCH STATE (4 Nov 2026). The job has never run on the real sources, its one partial run
  //            published nothing (2 of 40 phrases passed, 8 are needed), and a job that fails every night turns /api/v1/health/jobs red and opens a Watchdog issue.
  // The way on (runbook, "LAUNCH DARK"): make a first list by hand and read it, then "dark" (the job runs, still hidden), then take the TRENDING line out and push.
  // "MCP": "beta" (9 Nov 2026, the owner's go): the MCP server runs only for the account ids in MCP_BETA_USERS, which is a Worker secret (`wrangler secret put MCP_BETA_USERS`), not a
  // var, so that an account id is not in this public repository. Its privacy sentence is on the page (legal-match.test.ts, FLAG_SENTENCES). Off at once: `flag:MCP off` in CACHE.
  // "CHAT_TOOLS": "on" (10 Nov 2026, the owner read its sentence on 9 Nov): tools run in the reply (docs/design/chat-tools.md). Off at once: `flag:CHAT_TOOLS off` in CACHE.
  "vars": { "EXPECT_CRON": "1", "TRENDING": "off", "MCP": "beta", "CHAT_TOOLS": "on" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },

  // A second, empty copy of the service to try a change on before production: `npm run deploy:staging -w apps/api`.
  // Its own database, file bucket, queue and rate-limit counters, so nothing here can touch real people's data. No daily clean-up
  // job. Secrets are separate too (`wrangler secret put NAME --env staging`); sign-in works only after this address is added
  // to the Google/ORCID redirect list (docs/runbook.md, "Staging").
  "env": {
    "staging": {
      "name": "scholar-staging",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/oauth-authorization-server", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scholar-db-staging",
          "database_id": "59573daa-9ce0-4ccf-a5d0-5ab8fa23e679",
          "migrations_dir": "migrations"
        }
      ],
      "queues": { "producers": [{ "queue": "scholar-jobs-staging", "binding": "JOBS" }] },
      "workflows": [
        { "name": "scholar-oa-ingest-staging", "binding": "OA_INGEST", "class_name": "OaIngest" },
        { "name": "scholar-litscan-staging", "binding": "LITSCAN", "class_name": "LitscanRun" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "scholar-files-staging" }],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "4fba839cd6a84242955f48463b5bef02" },
        { "binding": "OAUTH_KV", "id": "9ff6033bd73c4fa7ac159c5351fb785b" }
      ],
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "S2_THROTTLE", "class_name": "S2Throttle" }, { "name": "API_GATE", "class_name": "ApiGate" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S2Throttle"] }, { "tag": "v2", "new_sqlite_classes": ["ApiGate"] }],
      "ratelimits": [
        { "name": "SEARCH_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "VERIFY_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
        { "name": "ASK_LIMITER", "namespace_id": "2004", "simple": { "limit": 20, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 240, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": { "crons": [] },
      // EXPECT_CRON is "0": staging has no schedule, so /api/v1/health/jobs must not report a job that was never meant to run.
      "vars": { "SENTRY_ENVIRONMENT": "staging", "EXPECT_CRON": "0" },
      "observability": { "enabled": true }
    }
  }
}
