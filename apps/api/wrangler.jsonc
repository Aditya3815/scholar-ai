{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scholar",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "account_id": "6de82fc604465aa52a67dee951309199",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scholar-db",
      "database_id": "4da3d12e-056a-4335-8359-034a9a8d628f",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "scholar-jobs", "binding": "JOBS" }]
  },
  "observability": { "enabled": true }
  // R2 binding add karna hai jab R2 dashboard se enable ho jaye:
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "scholar-files" }]
}
