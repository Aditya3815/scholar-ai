        "papers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "n": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Position in this answer, from 1"
              },
              "title": {
                "type": "string"
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Up to the first ten authors"
              },
              "year": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "venue": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "doi": {
                "description": "Only a DOI that was checked against the registry (a DOI that did not exist or belonged to another record is removed)",
                "type": [
                  "string",
                  "null"
                ]
              },
              "doi_resolves": {
                "description": "true: registered with Crossref or resolving at doi.org; null: no DOI, or it could not be checked",
                "type": [
