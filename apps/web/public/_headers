# Security and caching headers for the static app. (Cloudflare does not apply this file to responses the Worker generates;
# the API sets its own in apps/api/src/index.ts.)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://lh3.googleusercontent.com; font-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# A scan shared by a link: not indexed, not cached, and the address (the link is the key) is never sent on to a site the page links to.
/literature-scan/shared/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# A shared paper's link (docs/design/paper-share.md, 2.3): the token is the key, so the page is not indexed, not cached, and never sends its address on as a referrer.
/s/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# A paper's own page (also where a shared paper opens): never indexed.
/papers/*
  X-Robots-Tag: noindex, nofollow

# Vite fingerprints everything under /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker for offline reading must be looked at again at every visit so a new version replaces the old one.
/sw.js
  Cache-Control: no-cache

# pdf.js data files (copied at build time): safe to cache for a day.
/pdfjs/*
  Cache-Control: public, max-age=86400
