{
  "name": "scholar",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "devDependencies": { "undici": "7.30.1" },
  "overrides": { "undici": "$undici" },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:scripts": "node --test \".github/scripts/*.test.mjs\" \"apps/api/scripts/lib/*.node-test.mjs\"",
    "eval": "npm run eval -w apps/api",
    "deploy": "npm run build && npm run deploy -w apps/api",
    "db:migrate:local": "npm run db:migrate:local -w apps/api",
    "db:migrate:remote": "npm run db:migrate:remote -w apps/api"
  }
}
